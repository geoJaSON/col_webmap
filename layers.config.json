{
  "_comment": [
    "Categories for the reference layers drawn under the leases.",
    "A category is a blocker type: everything in it shares a colour and one",
    "buffer distance. Add a shapefile anywhere in the repo, map its slug to a",
    "category here, and re-run scripts/import_layers.py -- no code changes.",
    "bufferFeet is the default the slider starts at; 0 means no buffer."
  ],
  "categories": {
    "restoration-area": {
      "label": "Restoration area",
      "color": "#4db6d0",
      "bufferFeet": 1000
    },
    "pipelines": {
      "label": "Pipelines",
      "color": "#edac45",
      "bufferFeet": 500,
      "geometryType": "line",
      "keepFields": ["rrc_id", "operator", "system", "subsystem", "commodity", "diameter_inches", "permit", "system_type", "status", "county"]
    },
    "shorelines": {
      "label": "Shorelines",
      "color": "#4c9b72",
      "bufferFeet": 1000,
      "geometryType": "line",
      "simplifyDegrees": 0,
      "keepFields": ["shoreline_id", "esi", "most_sensitive", "landward_shoretype", "seaward_shoretype1", "seaward_shoretype2", "shoreline_type", "source_id", "esi_source"]
    }
  },
  "layers": {
    "hannas-reef-permit-area": "restoration-area",
    "coastal-lease-polygon-c-tcms": "restoration-area",
    "rrc-pipelines": "pipelines",
    "esi-shorelines": "shorelines"
  },
  "sources": ["data/pipelines/rrc-pipelines.geojson", "data/shorelines/esi-shorelines.geojson"],
  "defaultCategory": "restoration-area",
  "nameFields": [
    "GLO_ID",
    "NAME",
    "Name",
    "name",
    "ID",
    "Id"
  ]
}
