# Supabase project credentials.
# Both are server-side only -- no Supabase key is ever sent to the browser,
# because every read and write goes through this app's own /api routes.
# Find them at: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If set, the whole site asks for this passcode before it opens.
# Leave unset and anyone with the URL can view and edit.
# SITE_PASSCODE=
