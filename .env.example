# Service-role credentials, used only by this app's own /api routes for the
# COL applications table and the survey export. Never sent to the browser.
# Find them at: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public, browser-safe keys. These are REQUIRED -- the whole site is behind a
# CV Carbon sign-in, and without them nobody can get in at all. They also carry
# the polling layer and the ground-sample form, both of which read and write as
# the signed-in person under RLS.
#
# Read into the bundle at build time, so a deploy missing them cannot be fixed
# by setting them afterwards; it has to be rebuilt without the build cache.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
