# Supabase project credentials.
# Both are server-side only -- no Supabase key is ever sent to the browser,
# because every read and write goes through this app's own /api routes.
# Find them at: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. If set, the whole site asks for this passcode before it opens.
# Leave unset and anyone with the URL can view and edit.
# SITE_PASSCODE=

# Public, browser-safe keys for the polling-points layer. These let a person
# sign in to the wider platform so the tile function can decide what they are
# allowed to see; every table they reach is governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
